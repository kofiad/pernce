# Copy to .env.local (git-ignored). Expo reads it for every command,
# including the app config during native builds.

# The sync server new sign-ins start with, e.g. your own deployment of
# web/. Without it, phones ask for the address on the sign-in screen and
# the web build syncs with the origin that serves it.
# SYNC_URL=https://sync.example.com

# Your own app identity, for a fork you publish (TRADEMARKS.md). Unset,
# app.json's values apply. APP_ID is the iOS bundle ID and Android package;
# changing it installs as a different app.
# APP_ID=com.example.money
# EAS_OWNER=your-expo-username
# EAS_PROJECT_ID=00000000-0000-0000-0000-000000000000
