{
  // The server: what Vercel's build and the Worker bundle. Checked with
  // production dependencies only (`pnpm run build`), so nothing here may
  // import a devDependency; node.ts, the tests and the scripts are in
  // tsconfig.tools.json.
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["esnext"],
    "types": ["node"],
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true
  },
  "include": ["src/**/*.ts"],
  "exclude": ["node_modules", "src/node.ts"]
}
