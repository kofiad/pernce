# libSQL database URL. For local dev, a SQLite file in web/ (git-ignored).
# For the hosted instance, a Turso database (libsql://…) plus its token —
# see README.md.
DATABASE_URL=file:local.db
DATABASE_AUTH_TOKEN=

# Long random string the sync server derives its token-signing and code
# keys from. Generate one with:
#   openssl rand -base64 32
SESSION_SECRET=replace-with-a-long-random-string

# Optional: only needed in production, to stop random requests from hitting
# your FX-rate refresh endpoint. Vercel sends this automatically for its own
# Cron invocations once the env var is set — see README.md.
CRON_SECRET=

# Sync server (src/sync, docs/mobile-scope.md §6). Sign-up and
# password-reset codes go out through Gmail SMTP: SMTP_USER is the Gmail
# address, SMTP_PASSWORD an app password for it (needs 2-step verification;
# https://myaccount.google.com/apppasswords), not the account password.
# Without these, `pnpm run dev` (NODE_ENV=development) prints the email to
# the server log and everything else answers sign-up/reset with a 503.
SMTP_USER=
SMTP_PASSWORD=
# Optional: use another SMTP provider instead of Gmail. Port 465 uses
# implicit TLS; any other port (e.g. 587) uses STARTTLS. SMTP_USER is also
# the From address, so it must be an address the provider lets you send as.
SMTP_HOST=
SMTP_PORT=

# Origins allowed to call the sync API and /api/fx from a browser,
# comma-separated. Development: the web app's dev server (expo start --web).
# The Vercel instance's web app is same-origin and needs none; the Cloudflare
# Worker sets https://pernce.com in wrangler.jsonc. Nothing is allowed
# unless listed. (WEB_APP_ORIGINS, the old name, still works.)
ALLOWED_ORIGINS=http://localhost:8081

# Optional sync abuse limits: sign-ups stop at SYNC_MAX_USERS accounts
# (default 100), and each user may store SYNC_QUOTA_BYTES of encrypted
# data (default 26214400, 25 MB).
SYNC_MAX_USERS=
SYNC_QUOTA_BYTES=

